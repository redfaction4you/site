{
  "name": "@redfaction4you/site",
  "version": "0.1.0",
  "private": true,
  "description": "RedFaction4You community site. Phase 1 skeleton.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/*.test.mjs\"",
    "rfl": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/inspect-level.mjs",
    "backup:read": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/restore-backup.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node scripts/check-db.mjs",
    "ai:quota": "node scripts/ai-quota.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "refs:push": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/refs-push.mjs",
    "refs:label": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/refs-label.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.10.0",
    "@aws-sdk/client-s3": "^3.1097.0",
    "@neondatabase/serverless": "^1.0.1",
    "drizzle-orm": "^0.44.3",
    "next": "^15.4.5",
    "next-auth": "^5.0.0-beta.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "dotenv": "^17.2.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.5",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
