# ---------------------------------------------------------------------------
# RedFaction4You - Phase 1 environment
# Copy to .env.local for development. Set the same keys in Vercel for staging.
# ---------------------------------------------------------------------------

# Auth.js session encryption key.
# Generate with:  npx auth secret     (or)  openssl rand -base64 32
AUTH_SECRET=

# Auth.js base URL. Leave unset on Vercel, it is detected automatically.
# Set explicitly for local dev only if you are not on the default port.
# AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Discord OAuth
# Discord Developer Portal -> Applications -> your app -> OAuth2
# Redirect URIs must include, exactly:
#   http://localhost:3000/api/auth/callback/discord
#   https://<your-vercel-preview-domain>/api/auth/callback/discord
#   https://redfaction4you.com/api/auth/callback/discord
# ---------------------------------------------------------------------------
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Your Discord server (guild) ID. Enable Developer Mode in Discord,
# then right-click the server icon -> Copy Server ID.
DISCORD_GUILD_ID=

# Role IDs inside that guild, used to grant site roles on sign-in.
# Right-click a role in Server Settings -> Roles -> Copy Role ID.
# Leave blank to disable that mapping. Comma-separate to accept several roles.
DISCORD_ROLE_ADMIN=
DISCORD_ROLE_MAPPER=

# Public values, safe to expose to the browser.
NEXT_PUBLIC_DISCORD_GUILD_ID=
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite-code

# ---------------------------------------------------------------------------
# Database - Neon Postgres
# Neon dashboard -> your project -> Connection string -> "Pooled connection".
# Must include ?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Unpooled/direct connection. Used by drizzle-kit for migrations only.
# Neon dashboard -> Connection string -> untick "Pooled connection".
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# File storage - Cloudflare R2 (Phase 2)
# The public base URL of the bucket, no trailing slash. Every download and
# screenshot URL is this plus the stored object key, which is what makes those
# links permanent.
# Leave unset and the catalogue still works; downloads render an honest
# "storage not configured" notice instead of a dead link.
# Also used by next.config.ts to allow the domain for image optimisation.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_R2_PUBLIC_BASE=

# ---------------------------------------------------------------------------
# Match archive
# Shared secret between the dedicated server's sync task and this site's
# ingest endpoint. Server-side only; never prefix with NEXT_PUBLIC_.
# Must be at least 32 characters - the route rejects anything shorter.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
RF4U_ARCHIVE_SYNC_SECRET=

# ---------------------------------------------------------------------------
# Generated writing (optional)
# Match reports, the nightly column, player profiles and the column
# illustration. Leave every key unset and the features are simply off: pages
# render without them and nothing else changes.
#
# Keys are tried in order, Gemini first, then OpenAI, then Anthropic, until one
# answers. This is capacity, not redundancy: the Gemini free tier allows only
# TWENTY requests per day per model per PROJECT, and a four match night with
# five players needs about eleven. Run `npm run ai:quota` to see where each key
# stands.
#
# Adding keys is the way to add capacity, and GEMINI_API_KEY_2 upward are read
# through _10. One catch: the allowance is per project, not per key, so a second
# key made inside the same Google Cloud project shares the first one's twenty.
# New keys have to come from new projects, which in practice means a different
# Google account each.
#
# ANTHROPIC_API_KEY is worth more than another Gemini project despite being last
# in the chain, because it fails independently. Gemini answering 503 has already
# cost one night's column.
#
# AI_PROVIDER forces a single provider when more than one is configured.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic keys, read through _4. Last in the chain and worth having: these are
# paid rather than rationed, so they answer on the nights every free Gemini
# allowance is spent, which is exactly when the writing would otherwise stop.
# A second key here is a second balance rather than a second allowance.
#
# Keys must start with sk-ant-. Anything else is ignored with a warning, because
# an OpenAI key pasted into ANTHROPIC_API_KEY_2 sits there looking configured and
# fails in a way that reads like the provider being down.
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_2=
ANTHROPIC_API_KEY_3=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

AI_PROVIDER=

# Checks the generated illustration for lettering, faces and coherence before it
# is published. Needs a multimodal model; falls back to GEMINI_MODEL, which is
# one. Only set this if the text model stops being multimodal.
GEMINI_VISION_MODEL=

# ---------------------------------------------------------------------------
# The column illustration
#
# Cloudflare Workers AI is the provider that actually has a free allowance for
# images. Gemini lists image models but gives them no free quota at all: six
# independent projects were checked and every one answered 429 with no allowance.
# Check yours with `npm run ai:quota -- --images`.
#
# The account id is shared with R2 and defaults to R2_ACCOUNT_ID, so normally
# only the token is needed. It must be a SEPARATE token from the R2 one:
#   Cloudflare dashboard -> AI -> Workers AI -> Use REST API -> Create token
#   (or My Profile -> API Tokens with the "Workers AI" read permission)
# Leave it unset and columns simply publish without a picture.
# ---------------------------------------------------------------------------
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_IMAGE_MODEL=

# One key, used ONLY for image generation.
#
# This exists because of how Google bills. The free API tier lives in projects with
# no billing account, and enabling billing on a project moves everything that
# project serves onto pay as you go. Image models have no free allowance at all, so
# a picture needs a billed project, while all the writing fits comfortably in the
# free allowance of the other keys.
#
# So: enable billing on ONE Google Cloud project, put that project's key here, and
# leave the free keys above for text. The billed project then draws about thirty
# image requests a month and nothing else. Without this, turning billing on to get
# pictures would quietly put every column and report on the meter too.
#
# Note this is the Gemini API, which is not the Gemini app subscription. A Gemini
# Pro or Google One AI Premium plan does not grant API quota; they are separate
# products that share a name.
#
# Leave unset and images fall back to the ordinary key pool.
GEMINI_IMAGE_API_KEY=

# Overrides which Gemini image model is used. Normally discovered from the models
# endpoint, so leave blank. gemini-2.5-flash-image is the cheap one.
GEMINI_IMAGE_MODEL=

# Webhook that receives the nightly column. Server Settings -> Integrations ->
# Webhooks in Discord. Leave unset and columns are still written and still
# appear on the site, they are just not announced.
DISCORD_NEWS_WEBHOOK=

# ---------------------------------------------------------------------------
# Nightly backup
# Vercel Cron authenticates with this. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The backup itself needs the R2 variables above; it writes one gzipped JSON
# object per day under backups/ and keeps thirty.
# ---------------------------------------------------------------------------
CRON_SECRET=
